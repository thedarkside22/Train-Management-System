DATABASE_URL=sqlite:///./train_system.db
CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false

# Secret used to sign login tokens (JWT). Required with PostgreSQL. With local
# SQLite it may be left unset: a key file (backend/.jwt_secret_key) is then
# generated on first run. Changing it logs every user out.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Secret used to encrypt passenger national IDs, phones and emails.
# Required with PostgreSQL. With local SQLite it may be left unset: a key file
# (backend/.data_encryption_key) is then generated on first run.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Back it up. Without it the encrypted data cannot be read.
DATA_ENCRYPTION_KEY=
